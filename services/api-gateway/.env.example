# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Service URLs
IDENTITY_SERVICE_URL=http://localhost:3001
MEMORY_SERVICE_URL=http://localhost:3002
SENSING_SERVICE_URL=http://localhost:3003
GENERATION_SERVICE_URL=http://localhost:3004
INTERACTION_SERVICE_URL=http://localhost:3005
AUTONOMY_SERVICE_URL=http://localhost:3006
TRUTH_SERVICE_URL=http://localhost:3007
ECONOMY_SERVICE_URL=http://localhost:3008
GOVERNANCE_SERVICE_URL=http://localhost:3009

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=*

# Security
HELMET_ENABLED=true
COMPRESSION_ENABLED=true